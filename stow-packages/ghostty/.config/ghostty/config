# Disable programming ligatures (calt) and general ligatures (liga, dlig).
font-feature = -calt, -liga, -dlig

font-family = Inconsolata Nerd Font Mono
font-size = 22

# Force bash integration explicitly
shell-integration = bash

# Save window/tab/split layout on every quit, not just forced quits/crashes.
window-save-state = always

# --- Considering, not yet enabled ---

# iTerm2 profile had "Cursor Type: 1" (vertical bar) and "Blinking Cursor: 0".
# Note: shell integration forces a bar cursor at the prompt regardless of
# this setting, unless shell-integration-features includes no-cursor.
# cursor-style = bar
# cursor-style-blink = false

# iTerm2 profile had "Scrollback Lines: 1000000" (lines). Ghostty's limit is
# in bytes, not lines, so there's no exact equivalent — default is 10000000
# (~10MB). Raise if 10MB feels short in practice.
# scrollback-limit = 10000000

# iTerm2 profile had "Option Key Sends: 2" / "Right Option Key Sends: 2"
# (both sides send Esc+), for Option-as-Meta in shell/readline/nvim bindings.
# macos-option-as-alt = true
